	)
	(text "BAL_CLK=PA8(TIM1_CH1 75kHz)+R52 100k 下拉；PRECHG_EN=PA1+R51 100k 下拉；AFE_WAKE=MP2797 NSHDN(PB5 开漏，上拉 R_WAK 在 02 页)；"
		(exclude_from_sim no)
		(at 40.64 58.42 0)
